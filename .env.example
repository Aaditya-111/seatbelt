# --- PayPal sandbox credentials (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret

# sandbox is the default. "live" is refused unless ALLOW_LIVE=true.
PAYPAL_ENV=sandbox
ALLOW_LIVE=false

# Where PayPal sends the buyer after approving/cancelling. Use your app's URLs.
PAYPAL_RETURN_URL=https://example.com/success
PAYPAL_CANCEL_URL=https://example.com/cancel

# Secret used to sign spending mandates. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MANDATE_SIGNING_KEY=replace_me_with_a_long_random_string_of_32_plus_chars
# Longest lifetime an issued mandate may have
MANDATE_MAX_TTL_HOURS=24
# Key for the admin API (issuing mandates, approving payments). At least 24 characters and
# DIFFERENT from MANDATE_SIGNING_KEY. Generate with the same command as above.
ADMIN_API_KEY=replace_me_with_another_long_random_string
# Where the guard server listens. Keep 127.0.0.1 unless you know you need otherwise.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# SQLite file for payments, reservations and the audit log
DATABASE_PATH=seatbelt.db
# A payment pushing total usage above this fraction of the budget needs human approval
POLICY_BUDGET_ALERT_RATIO=0.8

# Optional tuning
PAYPAL_TIMEOUT_SECONDS=20
PAYPAL_MAX_RETRIES=3
LOG_LEVEL=INFO
LOG_JSON=false